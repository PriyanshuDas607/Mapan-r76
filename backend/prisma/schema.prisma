generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Laboratories ─────────────────────────────────────────────────────────────
// Managed by SUPER_ADMIN only.
model Laboratories {
  id           String         @id @default(uuid())
  name         String
  code         String         @unique // Short identifier e.g. "CSL", "LAB-MH-01"
  address      String?
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  // relations
  users        Users[]
  instruments  Instruments[]
  testSessions TestSessions[]
  reports      Reports[]
  auditLogs    AuditLog[]
}

// ─── Users ────────────────────────────────────────────────────────────────────
model Users {
  id                  String         @id @default(uuid())
  email               String         @unique
  password_hash       String
  // Legacy array field — kept for backward compat
  roles               String[] // e.g. ["LAB_ADMIN", "OPERATOR"]
  // New single-role field for 4-tier RBAC
  role                String         @default("TEST_ENGINEER") // SUPER_ADMIN | LAB_ADMIN | SUPERVISOR | TEST_ENGINEER
  labId               String? // null = SUPER_ADMIN (global) or unassigned
  created_at          DateTime       @default(now())
  active              Boolean        @default(true)
  // relations
  laboratory          Laboratories?  @relation(fields: [labId], references: [id])
  instruments         Instruments[]
  test_sessions       TestSessions[] @relation("OperatorSessions")
  supervised_sessions TestSessions[] @relation("SupervisorSessions")
  reports             Reports[]      @relation("SignerReports")
  approved_reports    Reports[]      @relation("ApproverReports")
}

// ─── Instruments ──────────────────────────────────────────────────────────────
model Instruments {
  id                   String         @id @default(uuid())
  labId                String
  serialNumber         String
  manufacturer         String?
  model                String?
  accuracyClass        String         @default("III") // I | II | III | IIII
  maxCapacity          Float?
  verificationInterval Float?
  calibrationDate      DateTime?
  metadata             Json?
  registeredByUserId   String?
  registeredBy         Users?         @relation(fields: [registeredByUserId], references: [id])
  laboratory           Laboratories?  @relation(fields: [labId], references: [id])
  // relations
  test_sessions        TestSessions[]

  @@map("Instruments")
}

// ─── TestSessions ─────────────────────────────────────────────────────────────
model TestSessions {
  id           String         @id @default(uuid())
  instrumentId String
  operatorId   String
  supervisorId String? // Assigned supervisor for review/approval
  labId        String? // Denormalized for fast lab-scope queries
  startedAt    DateTime       @default(now())
  endedAt      DateTime?
  // Extended status for 4-tier workflow
  status       String         @default("IN_PROGRESS")
  // IN_PROGRESS | COMPLETED | CANCELLED | PENDING_REVIEW | APPROVED | REJECTED
  feedback     String? // Supervisor feedback on rejection
  approvedAt   DateTime?
  rejectedAt   DateTime?
  // relations
  observations Observations[]
  calculation  Calculations?
  instrument   Instruments    @relation(fields: [instrumentId], references: [id])
  operator     Users          @relation("OperatorSessions", fields: [operatorId], references: [id])
  supervisor   Users?         @relation("SupervisorSessions", fields: [supervisorId], references: [id])
  laboratory   Laboratories?  @relation(fields: [labId], references: [id])
}

// ─── Observations ─────────────────────────────────────────────────────────────
model Observations {
  id          String       @id @default(uuid())
  sessionId   String
  data        Json
  recordedAt  DateTime     @default(now())
  testSession TestSessions @relation(fields: [sessionId], references: [id])
}

// ─── Calculations ─────────────────────────────────────────────────────────────
model Calculations {
  id            String       @id @default(uuid())
  sessionId     String       @unique
  engineVersion String
  result        Json
  hash          String // SHA-256 hex of result JSON (immutable fingerprint)
  createdAt     DateTime     @default(now())
  // relations
  testSession   TestSessions @relation(fields: [sessionId], references: [id])
  reports       Reports[]
}

// ─── Reports ──────────────────────────────────────────────────────────────────
model Reports {
  id            String        @id @default(uuid())
  calculationId String
  labId         String? // Denormalized for fast lab-scope queries
  version       Int           @default(1)
  // PENDING | APPROVED | SUPERSEDED | REVOKED | PENDING_APPROVAL | REJECTED
  status        String        @default("PENDING")
  pdfKey        String? // relative file path or S3 key
  sha256        String? // SHA-256 hex of the PDF bytes
  qrPayload     String? // JSON string: { reportId, sha256, verificationUrl }
  signedAt      DateTime?
  signerUserId  String?
  approvedBy    String? // User ID of the approver (LAB_ADMIN/SUPERVISOR)
  approvedAt    DateTime?
  rejectedBy    String?
  rejectedAt    DateTime?
  feedback      String? // Feedback on rejection
  createdAt     DateTime      @default(now())
  // relations
  calculation   Calculations  @relation(fields: [calculationId], references: [id])
  signerUser    Users?        @relation("SignerReports", fields: [signerUserId], references: [id])
  approver      Users?        @relation("ApproverReports", fields: [approvedBy], references: [id])
  laboratory    Laboratories? @relation(fields: [labId], references: [id])
}

// ─── AuditLog ─────────────────────────────────────────────────────────────────
model AuditLog {
  id           BigInt        @id @default(autoincrement())
  eventTime    DateTime      @default(now())
  userId       String?
  role         String? // Role of the actor at time of event
  labId        String? // Laboratory context of the event
  action       String // e.g. INSTRUMENT_REGISTERED, SESSION_STARTED, ...
  resourceType String?
  resourceId   String?
  ipAddress    String?
  userAgent    String?
  eventData    Json? // full event payload for chain hashing
  prevHash     String? // hex of previous entry's currHash
  currHash     String // hex: SHA256(prevHash + JSON.stringify(eventData))
  // relations
  laboratory   Laboratories? @relation(fields: [labId], references: [id])
}
